<!-- app/views/carts/show.html.erb -->
<div class="container mt-4">
  <h1>Your Shopping Cart</h1>
  
  <% if @cart_items.empty? %>
    <div class="alert alert-info">
      Your cart is empty. <%= link_to "Continue shopping", products_path %>.
    </div>
  <% else %>
    <div class="table-responsive">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @cart_items.each do |item| %>
            <tr>
              <td>
                <div class="d-flex">
                  <% if item.product.image.attached? %>
                    <%= image_tag item.product.image.variant(resize_to_limit: [50, 50]), class: "me-3" %>
                  <% end %>
                  <div>
                    <h5><%= item.product.name %></h5>
                    <% if item.product.sku.present? %>
                      <small class="text-muted">SKU: <%= item.product.sku %></small>
                    <% end %>
                  </div>
                </div>
              </td>
              <td><%= number_to_currency(item.product.price) %></td>
              <td>
                <%= form_with url: update_cart_item_path(item), method: :patch, class: "d-flex align-items-center" do %>
                  <%= number_field_tag :quantity, item.quantity, min: 1, max: 99, class: "form-control form-control-sm", style: "width: 70px;" %>
                  <%= submit_tag "Update", class: "btn btn-sm btn-outline-primary ms-2" %>
                <% end %>
              </td>
              <td><%= number_to_currency(item.subtotal) %></td>
              <td>
                <%= button_to "Remove", remove_cart_item_path(item), method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Are you sure?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="3" class="text-end">Total:</th>
            <th><%= number_to_currency(@cart.total) %></th>
            <th></th>
          </tr>
        </tfoot>
      </table>
    </div>
    
    <div class="d-flex justify-content-between mt-4">
      <%= link_to "Continue Shopping", products_path, class: "btn btn-secondary" %>
      <%= link_to "Proceed to Checkout", "#", class: "btn btn-success" %>
    </div>
  <% end %>
</div>