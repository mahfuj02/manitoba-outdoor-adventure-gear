<!-- app/views/shared/_header.html.erb -->
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container">
    <!-- Logo -->
    <a class="navbar-brand d-flex align-items-center" href="<%= root_path %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#FFFFFF" class="bi bi-tree me-2" viewBox="0 0 16 16">
        <path d="M8.416.223a.5.5 0 0 0-.832 0l-3 4.5A.5.5 0 0 0 5 5.5h.098L3.076 8.735A.5.5 0 0 0 3.5 9.5h.191l-1.638 3.276a.5.5 0 0 0 .447.724H7V16h2v-2.5h4.5a.5.5 0 0 0 .447-.724L12.31 9.5h.191a.5.5 0 0 0 .424-.765L10.902 5.5H11a.5.5 0 0 0 .416-.777l-3-4.5zM6.437 4.758A.5.5 0 0 0 6 4.5h-.066L8 1.401 10.066 4.5H10a.5.5 0 0 0-.424.765L11.598 8.5H11.5a.5.5 0 0 0-.447.724L12.69 12.5H3.309l1.638-3.276A.5.5 0 0 0 4.5 8.5h-.098l2.022-3.235a.5.5 0 0 0 .013-.507z"/>
      </svg>
      <span class="fw-bold text-white">Manitoba Outdoor Adventure Gear</span>
    </a>
    
    <!-- Mobile Toggle -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <!-- Navigation -->
    <div class="collapse navbar-collapse" id="navbarMain">
      <!-- Search Form -->
      <form class="d-flex mx-auto" action="<%= products_path %>" method="get">
        <div class="input-group" style="max-width: 400px;">
          <input type="search" name="search" class="form-control bg-white border-0" placeholder="Search products..." aria-label="Search" style="border-radius: 4px 0 0 4px;">
          <button class="btn search-btn" type="submit">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
              <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
            </svg>
          </button>
        </div>
      </form>
      
      <!-- Main Navigation -->
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link text-white" href="<%= root_path %>">Home</a>
        </li>
        
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle text-white" href="#" id="categoriesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Categories
          </a>
          <ul class="dropdown-menu" aria-labelledby="categoriesDropdown">
            <% Category.all.each do |category| %>
              <li><a class="dropdown-item category-item" href="<%= products_path(category_id: category.id) %>"><%= category.name %></a></li>
            <% end %>
          </ul>
        </li>
        
                      
        <li class="nav-item">
          <a class="nav-link text-white" href="<%= products_path %>">Products</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white" href="<%= about_path %>">About</a>
        </li>
        
        <li class="nav-item">
          <a class="nav-link text-white" href="<%= contact_path %>">Contact</a>
        </li>
        
        <!-- Cart -->
        <li class="nav-item">
          <a class="nav-link text-white" href="<%= cart_path if defined?(cart_path) %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cart" viewBox="0 0 16 16">
              <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <% if @cart_count && @cart_count > 0 %>
              <span class="position-absolute top-20 start-4 translate-middle bg-warning badge rounded-pill text-white">
                <%= @cart_count %>
            </span>
          <% end %>
          </a>
        </li>
        
        <!-- User Account -->
        <% if user_signed_in? %>
  <li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
      </svg>
      <span class="ms-1 d-none d-lg-inline"><%= current_user.full_name %></span>
    </a>
    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
  
      
      <li><a class="dropdown-item" href="<%= edit_user_registration_path %>">
        <i class="bi bi-person me-2"></i>My Profile
      </a></li>
      
      <li><a class="dropdown-item" href="<%= addresses_path if defined?(addresses_path) %>">
        <i class="bi bi-geo-alt me-2"></i>My Addresses
      </a></li>
      
      <li><a class="dropdown-item" href="<%= orders_path if defined?(orders_path) %>">
        <i class="bi bi-bag me-2"></i>My Orders
      </a></li>
      
      <li><hr class="dropdown-divider"></li>
      
      <li>
        <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item log-out", form: { data: { turbo: false } } do %>
          <i class="bi bi-box-arrow-right me-2 log-out"></i>Sign Out
        <% end %>
      </li>
    </ul>
  </li>
<% else %>
  <li class="nav-item">
    <a class="nav-link text-white" href="<%= new_user_session_path %>">
      <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link text-white" href="<%= new_user_registration_path %>">
      <i class="bi bi-person-plus me-1"></i>Register
    </a>
  </li>
<% end %>
      </ul>
    </div>
  </div>
</nav>