<!-- app/views/shared/_footer.html.erb -->
<div class="container mx-auto px-4 py-8">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Company Info -->
    <div class="col-span-1 md:col-span-1">
      <h3 class="text-lg font-bold text-white mb-4">Manitoba Outdoor Adventure Gear</h3>
      <p class="text-gray-200 mb-4">Your trusted source for high-quality outdoor equipment in Manitoba.</p>
    </div>
    
    <!-- Quick Links -->
    <div>
      <h3 class="text-lg font-bold text-white mb-4">Quick Links</h3>
      <ul class="space-y-2">
        <li><a href="<%= root_path %>" class="text-gray-200 hover:text-yellow-300 transition-colors">Home</a></li>
        <li><a href="<%= products_path %>" class="text-gray-200 hover:text-yellow-300 transition-colors">All Products</a></li>
        <li><a href="<%= about_path %>" class="text-gray-200 hover:text-yellow-300 transition-colors">About Us</a></li>
        <li><a href="<%= contact_path %>" class="text-gray-200 hover:text-yellow-300 transition-colors">Contact</a></li>
      </ul>
    </div>
    
    <!-- Categories -->
    <div>
      <h3 class="text-lg font-bold text-white mb-4">Categories</h3>
      <ul class="space-y-2">
        <% Category.limit(4).each do |category| %>
          <li>
            <a href="<%= products_path(category_id: category.id) %>" class="text-gray-200 hover:text-yellow-300 transition-colors">
              <%= category.name %>
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
  
  <!-- Bottom Footer -->
  <div class="border-t border-gray-700 mt-8 pt-8 text-center md:text-left">
    <p class="text-gray-300">&copy; <%= Time.now.year %> Manitoba Outdoor Adventure Gear. All rights reserved.</p>
  </div>
</div>