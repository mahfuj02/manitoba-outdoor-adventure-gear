<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>Manitoba Outdoor Adventure Gear</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="<%= root_path %>">Manitoba Outdoor Adventure Gear</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="<%= root_path %>">Home</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                Categories
              </a>
              <ul class="dropdown-menu">
                <% Category.all.each do |category| %>
                  <li><a class="dropdown-item" href="<%= products_path(category_id: category.id) %>"><%= category.name %></a></li>
                <% end %>
              </ul>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="<%= about_path %>">About</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="<%= contact_path %>">Contact</a>
            </li>
          </ul>
        </div>
        
      </div>
    </nav>
    
    <!-- Main content -->
    <div class="container mt-4">
    <%= render 'shared/flash_messages' %>
      <%= yield %>
    </div>
    
    <!-- Footer -->
    <footer class="bg-dark text-white mt-5 py-4">
      <div class="container">
        <div class="row">
          <div class="col-md-6">
            <h5>Manitoba Outdoor Adventure Gear</h5>
            <p>Your source for quality outdoor gear in Manitoba.</p>
          </div>
          <div class="col-md-6 text-md-end">
            <p>&copy; <%= Time.now.year %> Manitoba Outdoor Adventure Gear</p>
          </div>
        </div>
      </div>
    </footer>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>