<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>Manitoba Outdoor Adventure Gear</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Main application stylesheets -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <!-- JavaScript -->
    <%= javascript_importmap_tags %>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">
    

  </head>

  <body>
    <!-- Header / Navigation -->
    <header class="site-header">
      <%= render 'shared/header' %>
    </header>
    
    <!-- Flash messages -->
    <div class="container mt-3">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>
    
    <!-- Main content -->
    <main>
      <%= yield %>
    </main>
    
    <!-- Footer -->
    <footer class="site-footer py-5 mt-auto">
      <div class="container">
        <div class="row g-4">
          <div class="col-md-4">
            <h5 class="text-white mb-3">Manitoba Outdoor Adventure Gear</h5>
            <p class="text-white-75 mb-0">Your trusted source for high-quality outdoor equipment in Manitoba.</p>
          </div>
          
          <div class="col-md-4">
            <h5 class="text-white mb-3">Quick Links</h5>
            <ul class="list-unstyled mb-0">
              <li class="mb-2"><a href="<%= root_path %>" class="footer-link">Home</a></li>
              <li class="mb-2"><a href="<%= products_path %>" class="footer-link">All Products</a></li>
              <li class="mb-2"><a href="<%= about_path %>" class="footer-link">About Us</a></li>
              <li class="mb-2"><a href="<%= contact_path %>" class="footer-link">Contact</a></li>
            </ul>
          </div>
          
          <div class="col-md-4">
            <h5 class="text-white mb-3">Categories</h5>
            <ul class="list-unstyled mb-0">
              <% Category.limit(4).each do |category| %>
                <li class="mb-2"><a href="<%= products_path(category_id: category.id) %>" class="footer-link"><%= category.name %></a></li>
              <% end %>
            </ul>
          </div>
        </div>
        
        <div class="border-top border-secondary mt-4 pt-4 text-center text-md-start">
          <p class="text-white-50 mb-0">&copy; <%= Time.now.year %> Manitoba Outdoor Adventure Gear. All rights reserved.</p>
        </div>
      </div>
    </footer>
    
    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>