<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>Manitoba Outdoor Adventure Gear</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="<%= root_path %>">Manitoba Outdoor Adventure Gear</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="<%= root_path %>">Home</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                Categories
              </a>
              <ul class="dropdown-menu">
                <% Category.all.each do |category| %>
                  <li><a class="dropdown-item" href="<%= products_path(category_id: category.id) %>"><%= category.name %></a></li>
                <% end %>
              </ul>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="<%= about_path %>">About</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="<%= contact_path %>">Contact</a>
            </li>
            <li class="nav-item">
  <% if user_signed_in? %>
    <%= link_to "My Orders", orders_path, class: "nav-link" %>
  <% end %>
</li>
            <!-- In your application layout navbar -->
<li class="nav-item dropdown">
  <a class="nav-link dropdown-toggle" href="#" id="cartDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="bi bi-cart"></i> Cart
    <% if @cart_count && @cart_count > 0 %>
      <span class="badge bg-danger"><%= @cart_count %></span>
    <% end %>
  </a>
  <%= render 'layouts/mini_cart' %>
</li>
          </ul>
          <!-- Simple search form for the navbar -->
      <form class="d-flex" action="<%= products_path %>" method="get">
        <input class="form-control me-2" type="search" name="search" placeholder="Quick search..." aria-label="Search">
        <button class="btn btn-outline-light" type="submit">Search</button>
      </form>

        </div>
        <!-- app/views/layouts/application.html.erb -->
<div class="user-nav">
  <% if user_signed_in? %>
    <span style="color: white; font-weight: bold; padding: 5px; ">Welcome , <%= current_user.first_name %>!</span>
    <%= link_to 'Edit Profile', edit_user_registration_path %>
    <%= link_to 'Logout', destroy_user_session_path, data: { turbo_method: :delete } %>
  <% else %>
    <%= link_to 'Sign Up', new_user_registration_path %>
    <%= link_to 'Login', new_user_session_path %>
  <% end %>
</div>
        
      </div>
    </nav>
    <!-- app/views/layouts/application.html.erb (add after navbar) -->
<div id="flash-messages" class="container mt-3">
  <% flash.each do |type, message| %>
    <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show">
      <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>
</div>
    
    <!-- Main content -->
    <div class="container mt-4">
    <%= render 'shared/flash_messages' %>
      <%= yield %>
    </div>
    
    <!-- Footer -->
    <footer class="bg-dark text-white mt-5 py-4">
      <div class="container">
        <div class="row">
          <div class="col-md-6">
            <h5>Manitoba Outdoor Adventure Gear</h5>
            <p>Your source for quality outdoor gear in Manitoba.</p>
          </div>
          <div class="col-md-6 text-md-end">
            <p>&copy; <%= Time.now.year %> Manitoba Outdoor Adventure Gear</p>
          </div>
        </div>
      </div>
    </footer>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>