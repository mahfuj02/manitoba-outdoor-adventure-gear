
<!-- app/views/products/_product.html.erb (partial) -->
<div class="card h-100">
  <% if product.image.attached? %>
    <%= image_tag product.image, class: "card-img-top", alt: product.name %>
  <% else %>
    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
      <span class="text-muted">No image available</span>
    </div>
  <% end %>

  <div class="card-body">
    <h5 class="card-title"><%= product.name %></h5>
    <p class="card-text"><%= truncate(product.description, length: 100) %></p>
    
    <!-- Updated price display with sale information -->
    <% if product.on_sale? && product.sale_price.present? %>
      <p class="card-text">
        <span class="text-decoration-line-through"><%= number_to_currency(product.price) %></span>
        <span class="text-danger fw-bold"><%= number_to_currency(product.sale_price) %></span>
        <span class="badge bg-danger">Sale!</span>
      </p>
    <% else %>
      <p class="card-text text-danger fw-bold"><%= number_to_currency(product.price) %></p>
    <% end %>
    
    <!-- New product badge -->
    <% if product.is_new? %>
      <span class="badge bg-success">New!</span>
    <% end %>
    
    <div class="d-flex justify-content-between mt-2">
      <%= link_to "View Details", product_path(product), class: "btn btn-primary text-white font-weight-bold" %>
    </div>
  </div>
  
</div>