<%# app/views/products/show.html.erb %>
<%= render 'shared/breadcrumb' %>

<div class="container my-5">
  <div class="row">
    <%# Product image column %>
    <div class="col-md-6 mb-4 mb-md-0">
      <div class="card border-0 shadow-sm">
        <% if @product.image.attached? %>
          <%= image_tag @product.image, class: "img-fluid rounded", alt: @product.name %>
        <% else %>
          <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
            <span class="text-muted">No image available</span>
          </div>
        <% end %>
      </div>
      
      <%# Additional images could go here in a carousel or grid %>
      <% if @product.respond_to?(:additional_images) && @product.additional_images.attached? %>
        <div class="row mt-3">
          <% @product.additional_images.each do |image| %>
            <div class="col-3">
              <%= image_tag image, class: "img-fluid rounded cursor-pointer hover-shadow", 
                  onclick: "document.getElementById('main-product-image').src='#{url_for(image)}'" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <%# Product details column %>
    <div class="col-md-6">
      <h1 class="text-primary mb-2"><%= @product.name %></h1>
      
      <%# Category and other metadata %>
      <div class="mb-3">
        <% if @product.category.present? %>
          <span class="me-3">
            <i class="bi bi-tag"></i> 
            <%= link_to @product.category.name, products_path(category_id: @product.category.id), class: "text-muted" %>
          </span>
        <% end %>
        
        <% if @product.sku.present? %>
          <span class="text-muted">SKU: <%= @product.sku %></span>
        <% end %>
      </div>
      
      <%# Pricing information %>
      <div class="mb-4">
        <% if @product.on_sale? && @product.sale_price.present? %>
          <div class="d-flex align-items-center mb-2">
            <h3 class="text-danger fw-bold me-3 mb-0"><%= number_to_currency(@product.sale_price) %></h3>
            <span class="text-decoration-line-through text-muted fs-4"><%= number_to_currency(@product.price) %></span>
            <span class="badge bg-danger ms-3">Sale!</span>
          </div>
          <p class="text-success">You save: <%= number_to_currency(@product.price - @product.sale_price) %></p>
        <% else %>
          <h3 class="text-primary fw-bold mb-0"><%= number_to_currency(@product.price) %></h3>
        <% end %>
      </div>
      
      <%# Product badges/availability %>
      <div class="mb-4">
        <% if @product.is_new? %>
          <span class="badge bg-success me-2">New Arrival</span>
        <% end %>
        
        <% if @product.stock_quantity > 0 %>
          <span class="badge bg-success me-2">
            <i class="bi bi-check-circle-fill"></i> In Stock
            <% if @product.stock_quantity < 5 %>
              (Only <%= @product.stock_quantity %> left)
            <% end %>
          </span>
        <% else %>
          <span class="badge bg-danger"><i class="bi bi-x-circle-fill"></i> Out of Stock</span>
        <% end %>
      </div>
      
      <%# Add to cart form %>
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <%= form_with url: add_to_cart_path(@product), method: :post, data: { turbo: false }, local: true, class: "d-flex flex-column" do %>
            <%= hidden_field_tag :product_id, @product.id %>
            
            <div class="row mb-3">
              <label for="quantity" class="col-sm-3 col-form-label">Quantity:</label>
              <div class="col-sm-9">
                <div class="input-group">
                  <button type="button" class="btn btn-outline-secondary" onclick="decrementQuantity()">-</button>
                  <%= number_field_tag :quantity, 1, min: 1, max: @product.stock_quantity, 
                      class: "form-control text-center", id: "quantity", 
                      disabled: (@product.stock_quantity <= 0) %>
                  <button type="button" class="btn btn-outline-secondary" onclick="incrementQuantity()">+</button>
                </div>
              </div>
            </div>
            
            <%= submit_tag "Add to Cart", class: "btn btn-primary btn-lg w-100", 
                disabled: (@product.stock_quantity <= 0) %>
          <% end %>
        </div>
      </div>
      
      <%# Tags %>
      <% if @product.respond_to?(:tags) && @product.tags.any? %>
        <div class="mb-4">
          <h5>Tags:</h5>
          <div>
            <% @product.tags.each do |tag| %>
              <%= link_to tag.name, products_path(tag_id: tag.id), class: "badge bg-secondary me-1 mb-1" %>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <%# Description %>
      <div class="mb-4">
        <h4>Description</h4>
        <hr>
        <div class="product-description">
          <%= @product.description %>
        </div>
      </div>
      
      <%# Specifications %>
      <% if @product.respond_to?(:weight) || @product.respond_to?(:dimensions) %>
        <div class="mb-4">
          <h4>Specifications</h4>
          <hr>
          <table class="table table-bordered">
            <tbody>
              <% if @product.respond_to?(:sku) && @product.sku.present? %>
                <tr>
                  <td class="fw-bold">SKU</td>
                  <td><%= @product.sku %></td>
                </tr>
              <% end %>
              <% if @product.respond_to?(:weight) && @product.weight.present? %>
                <tr>
                  <td class="fw-bold">Weight</td>
                  <td><%= @product.weight %> kg</td>
                </tr>
              <% end %>
              <% if @product.respond_to?(:dimensions) && @product.dimensions.present? %>
                <tr>
                  <td class="fw-bold">Dimensions</td>
                  <td><%= @product.dimensions %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
  
  <%# Related products section %>
  <% if @product.category && @product.category.products.where.not(id: @product.id).any? %>
    <div class="row mt-5">
      <div class="col-12">
        <h3 class="text-primary mb-4">You might also like</h3>
      </div>
      
      <% @product.category.products.where.not(id: @product.id).limit(3).each do |related_product| %>
        <div class="col-md-4 mb-4">
          <div class="card h-100 product-card shadow-sm">
            <% if related_product.image.attached? %>
              <%= link_to product_path(related_product) do %>
                <%= image_tag related_product.image, class: "card-img-top", style: "height: 200px; object-fit: cover;", alt: related_product.name %>
              <% end %>
            <% else %>
              <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                <span class="text-muted">No image available</span>
              </div>
            <% end %>
            
            <div class="card-body">
              <h5 class="card-title">
                <%= link_to related_product.name, product_path(related_product), class: "text-primary" %>
              </h5>
              <p class="card-text text-primary fw-bold"><%= number_to_currency(related_product.price) %></p>
              <%= link_to "View Details", product_path(related_product), class: "btn btn-primary" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  function incrementQuantity() {
    const quantityField = document.getElementById('quantity');
    const maxQuantity = <%= @product.stock_quantity %>;
    let currentValue = parseInt(quantityField.value, 10);
    
    if (currentValue < maxQuantity) {
      quantityField.value = currentValue + 1;
    }
  }
  
  function decrementQuantity() {
    const quantityField = document.getElementById('quantity');
    let currentValue = parseInt(quantityField.value, 10);
    
    if (currentValue > 1) {
      quantityField.value = currentValue - 1;
    }
  }
</script>