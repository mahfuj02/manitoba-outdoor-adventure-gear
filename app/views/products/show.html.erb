
<!-- app/views/products/show.html.erb -->
<%= render 'shared/breadcrumb' %>
<div class="container mt-4">
  <div class="row">
    <div class="col-md-6">
      <% if @product.image.attached? %>
        <%= image_tag @product.image, class: "img-fluid", alt: @product.name %>
      <% else %>
        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
          <span class="text-muted">No image available</span>
        </div>
      <% end %>
    </div>
    
    <div class="col-md-6">
      <h1><%= @product.name %></h1>
      
      <p class="text-muted">
        Category: <%= @product.category&.name || 'None' %>
      </p>
      
      <h3 class="text-danger"><%= number_to_currency(@product.price) %></h3>
      
      <div class="mb-4">
        <% if @product.stock_quantity > 0 %>
          <span class="badge bg-success">In Stock: <%= @product.stock_quantity %></span>
        <% else %>
          <span class="badge bg-danger">Out of Stock</span>
        <% end %>
      </div>
      <!-- app/views/products/show.html.erb (update button section) -->
<div class="mb-4">
  <%= form_with url: add_to_cart_path(@product), method: :post, class: "d-flex align-items-center" do %>
    <div class="input-group me-3" style="width: 130px;">
      <%= number_field_tag :quantity, 1, min: 1, max: @product.stock_quantity, class: "form-control" %>
    </div>
    <%= submit_tag "Add to Cart", class: "btn btn-primary btn-lg", disabled: (@product.stock_quantity <= 0) %>
  <% end %>
</div>
      
      <hr>
      
      <div class="mb-4">
        <h4>Description</h4>
        <p><%= @product.description %></p>
      </div>
    </div>
  </div>
</div>