<!-- app/views/checkout/index.html.erb -->
<div class="container mt-4">
  <h1>Checkout</h1>
  
  <div class="progress mb-4">
    <div class="progress-bar" role="progressbar" style="width: 50%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100">
      Step 1: Address Information
    </div>
  </div>
  
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5>Shipping Address</h5>
        </div>
        <div class="card-body">
        <!-- Update just the form part in app/views/checkout/index.html.erb -->
        <%= form_with(url: checkout_address_path, method: :post, local: true) do |f| %>
          <% if @shipping_address.persisted? %>
            <%= hidden_field_tag 'address[id]', @shipping_address.id %>
          <% end %>
          
          <div class="mb-3">
            <%= label_tag 'address[street]', "Street Address", class: "form-label" %>
            <%= text_field_tag 'address[street]', @shipping_address.street, class: "form-control", required: true %>
          </div>
          
          <div class="mb-3">
            <%= label_tag 'address[city]', "City", class: "form-label" %>
            <%= text_field_tag 'address[city]', @shipping_address.city, class: "form-control", required: true %>
          </div>
          
          <div class="mb-3">
            <%= label_tag 'address[province_id]', "Province", class: "form-label" %>
            <%= select_tag 'address[province_id]', 
                           options_from_collection_for_select(@provinces, 'id', 'display_name', @shipping_address.province_id),
                           { include_blank: "Select a province", class: "form-select", required: true } %>
          </div>
          
          <div class="mb-3">
            <%= label_tag 'address[postal_code]', "Postal Code", class: "form-label" %>
            <%= text_field_tag 'address[postal_code]', @shipping_address.postal_code, class: "form-control", required: true %>
          </div>
          
          <div class="mb-3">
            <%= label_tag 'address[country]', "Country", class: "form-label" %>
            <%= text_field_tag 'address[country]', @shipping_address.country || "Canada", class: "form-control", required: true %>
          </div>
          
          <div class="form-check mb-3">
            <%= check_box_tag 'address[is_default]', "1", @shipping_address.is_default?, class: "form-check-input" %>
            <%= label_tag 'address[is_default]', "Set as default address", class: "form-check-label" %>
          </div>
          
          <div class="d-flex justify-content-between">
            <%= link_to "Back to Cart", cart_path, class: "btn btn-secondary" %>
            <%= submit_tag "Continue to Review", class: "btn btn-primary" %>
          </div>
        <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>Order Summary</h5>
        </div>
        <div class="card-body">
          <% @cart_items.each do |item| %>
            <div class="d-flex justify-content-between mb-2">
              <div>
                <%= item[:product].name %> x <%= item[:quantity] %>
              </div>
              <div>
                <%= number_to_currency(item[:total]) %>
              </div>
            </div>
          <% end %>
          <hr>
          <div class="d-flex justify-content-between fw-bold">
            <div>Subtotal:</div>
            <div><%= number_to_currency(@total) %></div>
          </div>
          <div class="small text-muted mt-2">
            Taxes will be calculated at the next step based on your shipping address.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>