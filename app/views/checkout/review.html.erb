<!-- app/views/checkout/review.html.erb -->
<div class="container mt-4">
  <h1>Review Your Order</h1>
  
  <div class="progress mb-4">
    <div class="progress-bar" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
      Step 2: Review & Complete
    </div>
  </div>
  
  <div class="row">
    <div class="col-md-8">
      <div class="card mb-4">
        <div class="card-header">
          <h5>Order Items</h5>
        </div>
        <div class="card-body">
          <table class="table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th class="text-end">Price</th>
                <th class="text-end">Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% @cart_items.each do |item| %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <% if item[:product].image.attached? %>
                        <%= image_tag item[:product].image.variant(resize_to_limit: [50, 50]), class: "me-2" %>
                      <% end %>
                      <%= item[:product].name %>
                    </div>
                  </td>
                  <td><%= item[:quantity] %></td>
                  <td class="text-end"><%= number_to_currency(item[:price]) %></td>
                  <td class="text-end"><%= number_to_currency(item[:total]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card mb-4">
        <div class="card-header">
          <h5>Order Summary</h5>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <div>Subtotal:</div>
            <div><%= number_to_currency(@total) %></div>
          </div>
          
          <% if @province %>
            <% if @province.gst > 0 %>
              <div class="d-flex justify-content-between mb-2">
                <div>GST (<%= @province.gst %>%):</div>
                <div><%= number_to_currency(@total * @province.gst / 100) %></div>
              </div>
            <% end %>
            
            <% if @province.pst > 0 %>
              <div class="d-flex justify-content-between mb-2">
                <div>PST (<%= @province.pst %>%):</div>
                <div><%= number_to_currency(@total * @province.pst / 100) %></div>
              </div>
            <% end %>
            
            <% if @province.hst > 0 %>
              <div class="d-flex justify-content-between mb-2">
                <div>HST (<%= @province.hst %>%):</div>
                <div><%= number_to_currency(@total * @province.hst / 100) %></div>
              </div>
            <% end %>
          <% end %>
          
          <hr>
          <div class="d-flex justify-content-between fw-bold">
            <div>Total:</div>
            <div><%= number_to_currency(@grand_total) %></div>
          </div>
        </div>
      </div>
      
      <div class="card mb-4">
        <div class="card-header">
          <h5>Shipping Address</h5>
        </div>
        <div class="card-body">
          <p class="mb-0">
            <%= @shipping_address.street %><br>
            <%= @shipping_address.city %>, <%= @shipping_address.province.code %> <%= @shipping_address.postal_code %><br>
            <%= @shipping_address.country %>
          </p>
          <div class="mt-2">
            <%= link_to "Change Address", checkout_path, class: "btn btn-sm btn-outline-secondary" %>
          </div>
        </div>
      </div>
      
      <%= form_with(url: checkout_complete_path, method: :post, local: true) do |f| %>
        <div class="d-flex justify-content-between">
          <%= link_to "Back to Address", checkout_path, class: "btn btn-secondary" %>
          <%= f.submit "Place Order", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>